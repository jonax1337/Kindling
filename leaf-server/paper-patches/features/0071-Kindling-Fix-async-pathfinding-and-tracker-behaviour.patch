From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jonax1337 <jonas.laux@hotmail.com>
Date: Tue, 27 Oct 2026 23:00:04 +0100
Subject: [PATCH] Kindling: Fix async pathfinding and tracker behaviour
 differences


diff --git a/src/main/java/com/destroystokyo/paper/entity/PaperPathfinder.java b/src/main/java/com/destroystokyo/paper/entity/PaperPathfinder.java
index efb22c6535f74273ae92418a787e509fd91a8131..dbef7d59bc1ea8028ef20e4323bd4efbf93514ec 100644
--- a/src/main/java/com/destroystokyo/paper/entity/PaperPathfinder.java
+++ b/src/main/java/com/destroystokyo/paper/entity/PaperPathfinder.java
@@ -43,8 +43,11 @@ public class PaperPathfinder implements com.destroystokyo.paper.entity.Pathfinde
     @Nullable
     @Override
     public PathResult getCurrentPath() {
-        Path path = this.entity.getNavigation().getPath();
-        return path != null && !path.isDone() ? new PaperPathResult(path) : null;
+        // Kindling start - hand plugins processed paths (Leaf PR 943)
+        net.minecraft.world.entity.ai.navigation.PathNavigation navigation = this.entity.getNavigation();
+        Path path = processPath(navigation.getPath());
+        return path != null && navigation.leaf$preparePath() ? new PaperPathResult(path) : null;
+        // Kindling end - hand plugins processed paths (Leaf PR 943)
     }
 
     @Nullable
@@ -52,7 +55,7 @@ public class PaperPathfinder implements com.destroystokyo.paper.entity.Pathfinde
     public PathResult findPath(final Location loc, final int reachRange) {
         Preconditions.checkArgument(loc != null, "Location can not be null");
         Preconditions.checkArgument(reachRange >= 0, "Reach range can not be negative");
-        Path path = this.entity.getNavigation().createPath(loc.getX(), loc.getY(), loc.getZ(), reachRange);
+        Path path = processPath(this.entity.getNavigation().createPath(loc.getX(), loc.getY(), loc.getZ(), reachRange)); // Kindling - hand plugins processed paths (Leaf PR 943)
         return path != null ? new PaperPathResult(path) : null;
     }
 
@@ -61,10 +64,20 @@ public class PaperPathfinder implements com.destroystokyo.paper.entity.Pathfinde
     public PathResult findPath(final Entity target, final int reachRange) {
         Preconditions.checkArgument(target != null, "Target can not be null");
         Preconditions.checkArgument(reachRange >= 0, "Reach range can not be negative");
-        Path path = this.entity.getNavigation().createPath(((CraftEntity) target).getHandle(), reachRange);
+        Path path = processPath(this.entity.getNavigation().createPath(((CraftEntity) target).getHandle(), reachRange)); // Kindling - hand plugins processed paths (Leaf PR 943)
         return path != null ? new PaperPathResult(path) : null;
     }
 
+    // Kindling start - hand plugins processed paths (Leaf PR 943)
+    @Nullable
+    private static Path processPath(@Nullable Path path) {
+        if (path instanceof org.dreeam.leaf.async.path.AsyncPath asyncPath) {
+            asyncPath.process();
+        }
+        return path;
+    }
+    // Kindling end - hand plugins processed paths (Leaf PR 943)
+
     @Override
     public boolean moveTo(@Nonnull PathResult path, double speed) {
         Preconditions.checkArgument(path != null, "PathResult can not be null");
