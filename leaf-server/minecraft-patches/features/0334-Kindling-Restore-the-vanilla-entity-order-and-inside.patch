-                cornerVisitedBlockY,
-                cornerVisitedBlockZ,
-                cornerVisitedBlockX + 1,
-                cornerVisitedBlockY + 1,
-                cornerVisitedBlockZ + 1,
-                fromCorner,
-                toCorner
-            );
-            if (!hitPointOpt.isEmpty()) {
-                iterations++;
