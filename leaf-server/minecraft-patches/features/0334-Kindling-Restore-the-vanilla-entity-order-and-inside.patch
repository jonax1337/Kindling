             LongSet visitedBlocks = new LongOpenHashSet();
 
-            for (BlockPos blockPos : org.dreeam.leaf.util.list.SimpleBlockPosIterator.iterable(aabbAtTarget.move(travel.scale(-1.0)))) { // Leaf - Sakura - optimise check inside blocks
