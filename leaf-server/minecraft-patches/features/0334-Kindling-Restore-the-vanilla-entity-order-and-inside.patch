-                cornerVisitedBlockY += signY;
-                tY += tDeltaY;
-            } else {
-                cornerVisitedBlockZ += signZ;
-                tZ += tDeltaZ;
-            }
-
-            Optional<Vec3> hitPointOpt = AABB.clip(
