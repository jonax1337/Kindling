-                }
-
-                final int sectionMinX = Math.min(cornerVisitedBlockX, oppositeCornerX);
-                final int sectionMinY = Math.min(cornerVisitedBlockY, oppositeCornerY);
-                final int sectionMinZ = Math.min(cornerVisitedBlockZ, oppositeCornerZ);
