@@ -206,6 +206,10 @@ public class RegionFileStorage implements AutoCloseable, ca.spottedleaf.moonrise
         final CompoundTag ret;
         try {
             ret = ca.spottedleaf.moonrise.patches.nbt_rw.FastNBTParser.nbtIoRead(readData.input()); // Paper - Optimize NBT reading/writing
+        } catch (final IOException | RuntimeException ex) { // Kindling start - keep a copy of unreadable chunks
