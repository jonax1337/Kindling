@@ -238,6 +242,24 @@ public class RegionFileStorage implements AutoCloseable, ca.spottedleaf.moonrise
     }
     // Paper end - rewrite chunk system
 
+    // Kindling start - keep a copy of unreadable chunks
+    public void keepUnreadableChunk(final int chunkX, final int chunkZ, final Throwable cause) {
+        if (!ca.spottedleaf.moonrise.patches.chunk_system.storage.RegionFileRecovery.isChunkStorage(this.info)) {
+            return;
+        }
+
+        net.kindlingmc.chunk.ChunkQuarantine.forRegionFolder(this.info.level(), this.info.dimension().identifier().toString(), this.folder)
+            .keep(chunkX, chunkZ, maxBytes -> this.readRawChunk(chunkX, chunkZ, maxBytes), cause);
+    }
+
+    private byte[] readRawChunk(final int chunkX, final int chunkZ, final long maxBytes) throws IOException {
+        if (this.moonrise$getRegionFileIfExists(chunkX, chunkZ) instanceof RegionFile regionFile) {
+            return regionFile.readRawChunk(new ChunkPos(chunkX, chunkZ), maxBytes);
+        }
+        throw new IOException("The region file format of " + this.folder + " cannot hand out raw chunk bytes");
+    }
+    // Kindling end - keep a copy of unreadable chunks
+
     public RegionFileStorage(final RegionStorageInfo info, final Path folder, final boolean sync) {
         this.folder = folder;
         this.sync = sync;
