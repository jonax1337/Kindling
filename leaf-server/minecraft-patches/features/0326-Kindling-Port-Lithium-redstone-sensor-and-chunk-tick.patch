 import org.jspecify.annotations.Nullable;
 
 public final class Biome {
@@ -136,8 +133,9 @@ public final class Biome {
 
         if (level.isInsideBuildHeight(pos.getY()) && level.getBrightness(LightLayer.BLOCK, pos) < 10) {
             BlockState blockState = level.getBlockState(pos);
-            FluidState fluidState = level.getFluidState(pos);
-            if (fluidState.is(Fluids.WATER) && blockState.getBlock() instanceof LiquidBlock) {
+            // Kindling start - Lithium - the fluid comes from the block state at hand
+            if (net.kindlingmc.world.FreezableWater.isFreezableWater(blockState)) {
+            // Kindling end - Lithium - the fluid comes from the block state at hand
                 if (!checkNeighbors) {
                     return true;
                 }
diff --git a/net/minecraft/world/level/redstone/DefaultRedstoneWireEvaluator.java b/net/minecraft/world/level/redstone/DefaultRedstoneWireEvaluator.java
index 82ee509ffe0d3be94ae9b7580f60f1ac3c04f697..fac5f599cab4adb5b1bec31838332ba98960c78d 100644
--- a/net/minecraft/world/level/redstone/DefaultRedstoneWireEvaluator.java
+++ b/net/minecraft/world/level/redstone/DefaultRedstoneWireEvaluator.java
@@ -45,7 +45,8 @@ public class DefaultRedstoneWireEvaluator extends RedstoneWireEvaluator {
     }
 
     public int calculateTargetStrength(final Level level, final BlockPos pos) { // Paper - Optimize redstone
-        int blockSignal = this.getBlockSignal(level, pos);
-        return blockSignal == Redstone.SIGNAL_MAX ? blockSignal : Math.max(blockSignal, this.getIncomingWireSignal(level, pos));
+        // Kindling start - Lithium - look at every neighbour once and never ask a wire for its signal
+        return net.caffeinemc.mods.lithium.common.block.redstone.RedstoneWirePowerCalculations.getTargetStrength(this.wireBlock, level, pos);
+        // Kindling end - Lithium - look at every neighbour once and never ask a wire for its signal
     }
 }
