     public void onSyncedDataUpdated(final EntityDataAccessor<?> accessor) {
         if (DATA_BABY_ID.equals(accessor)) {
             this.refreshDimensions();
+            net.kindlingmc.ai.UselessSensors.onBabyFlagChanged(this); // Kindling - Lithium - baby sensors follow the age
         }
 
         super.onSyncedDataUpdated(accessor);
diff --git a/net/minecraft/world/entity/ai/Brain.java b/net/minecraft/world/entity/ai/Brain.java
index f576a0a1956e426f7601dc73bd3c13fe3e9e992d..6057e59e9361724d4b959fd4dfa06130c977d0b0 100644
