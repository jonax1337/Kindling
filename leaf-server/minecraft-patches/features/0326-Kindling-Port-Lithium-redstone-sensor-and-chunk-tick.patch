@@ -415,6 +415,15 @@ public class Brain<E extends LivingEntity> implements net.caffeinemc.mods.lithiu
         }
     }
 
+    // Kindling start - Lithium - let a sensor that was skipped as useless sense again right away
+    public void tickSensorOnNextCall(final SensorType<?> sensorType) {
+        final Sensor<? super E> sensor = this.sensors.get(sensorType);
+        if (sensor != null) {
+            sensor.tickOnNextCall();
+        }
+    }
+    // Kindling end - Lithium - let a sensor that was skipped as useless sense again right away
+
     private void forgetOutdatedMemories() {
         // Leaf start - Lithium - Reduce Brain memories lookup
         this.memories.values().forEach(slot -> {
diff --git a/net/minecraft/world/entity/ai/behavior/AcquirePoi.java b/net/minecraft/world/entity/ai/behavior/AcquirePoi.java
index 2e3a7e4e4d1b3b182b2a4db33dbf4821ccd5348c..3d7e2683262059539d5c44027118c3d13fb97141 100644
--- a/net/minecraft/world/entity/ai/behavior/AcquirePoi.java
+++ b/net/minecraft/world/entity/ai/behavior/AcquirePoi.java
@@ -54,6 +54,11 @@ public class AcquirePoi {
         final Optional<Byte> onPoiAcquisitionEvent,
         final BiPredicate<ServerLevel, BlockPos> validPoi
     ) {
+        // Kindling start - Lithium - a search for a POI of no type, as nitwits have for a job site, never finds anything
+        if (poiType == PoiType.NONE) {
+            return net.kindlingmc.ai.InertBehavior.instance();
+        }
+        // Kindling end - Lithium - a search for a POI of no type, as nitwits have for a job site, never finds anything
         return new AcquirePoiBehavior(poiType, memoryToValidate, memoryToAcquire, onPoiAcquisitionEvent, validPoi, onlyIfAdult);
     }
 
diff --git a/net/minecraft/world/entity/ai/sensing/Sensor.java b/net/minecraft/world/entity/ai/sensing/Sensor.java
index c321c01148b0c92d8c2c17bb8c8b460586653107..45f0868646a4a76d69ad2dbfbf3b6bb4b82516c6 100644
--- a/net/minecraft/world/entity/ai/sensing/Sensor.java
+++ b/net/minecraft/world/entity/ai/sensing/Sensor.java
@@ -60,10 +60,18 @@ public abstract class Sensor<E extends LivingEntity> {
             // Kaiiju end - petal - async path processing
             this.timeToTick = scanRateCache;
             this.updateTargetingConditionRanges(body);
-            this.doTick(level, body);
+            if (!net.kindlingmc.ai.UselessSensors.isUseless(this, body)) { // Kindling - Lithium - skip sensing for memories nothing reads
+                this.doTick(level, body);
+            }
         }
     }
 
+    // Kindling start - Lithium - let a sensor that was skipped as useless sense again right away
+    public final void tickOnNextCall() {
+        this.timeToTick = Math.min(this.timeToTick, 1L);
+    }
+    // Kindling end - Lithium - let a sensor that was skipped as useless sense again right away
+
     // Kaiiju start - petal - async path processing
     public final int getScanRate(ServerLevel level, final E body) {
         return java.util.Objects.requireNonNullElse(level.paperConfig().tickRates.sensor.get(body.getType(), this.configKey), this.scanRate); // Paper - configurable sensor tick rate and timings
diff --git a/net/minecraft/world/level/biome/Biome.java b/net/minecraft/world/level/biome/Biome.java
