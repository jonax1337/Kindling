+    // Kindling start - skip the biome lookup for types without any spawn cost
+    private static MobSpawnSettings.@Nullable MobSpawnCost biomeSpawnCost(final EnvironmentAttributeReader attributes, final EntityType<?> type, final BlockPos pos) {
+        if (!type.hasAnyBiomeSpawnCost()) {
+            return null;
+        }
+
+        return attributes.getValue(EnvironmentAttributes.NATURAL_MOB_SPAWNS, pos).getMobSpawnCost(type);
+    }
+    // Kindling end - skip the biome lookup for types without any spawn cost
