Subject: [PATCH] Kindling: Skip needless spawn cost biome lookups


diff --git a/net/minecraft/world/attribute/EnvironmentAttributeSystem.java b/net/minecraft/world/attribute/EnvironmentAttributeSystem.java
index 7d4707bea911e6cd2f9e7fd35204435a1cc5ed66..db9a75057cc3b3b385faaebb412ee031e37af50d 100644
--- a/net/minecraft/world/attribute/EnvironmentAttributeSystem.java
+++ b/net/minecraft/world/attribute/EnvironmentAttributeSystem.java
@@ -129,7 +129,28 @@ public class EnvironmentAttributeSystem implements EnvironmentAttributeReader {
     }
     // Leaf end - Pufferfish - async mob spawning
 
+    // Kindling start - one natural spawn try resolves the same position up to three times
+    private final net.kindlingmc.spawn.BlockPositionMemo<net.minecraft.world.level.biome.MobSpawnSettings> naturalMobSpawnsMemo = new net.kindlingmc.spawn.BlockPositionMemo<>();
+
+    public net.minecraft.world.level.biome.MobSpawnSettings getNaturalMobSpawnsMemoized(final net.minecraft.core.BlockPos pos) {
+        final int x = pos.getX();
+        final int y = pos.getY();
+        final int z = pos.getZ();
+        net.minecraft.world.level.biome.MobSpawnSettings settings = this.naturalMobSpawnsMemo.get(x, y, z);
+        if (settings == null) {
+            settings = this.getValue(EnvironmentAttributes.NATURAL_MOB_SPAWNS, pos);
+            this.naturalMobSpawnsMemo.put(x, y, z, settings);
+        }
+        return settings;
+    }
+
+    public void clearNaturalMobSpawnsMemo() {
+        this.naturalMobSpawnsMemo.clear();
+    }
+    // Kindling end - one natural spawn try resolves the same position up to three times
+
     public void invalidateTickCache() {
+        this.clearNaturalMobSpawnsMemo(); // Kindling - the memo never outlives a tick
         this.attributeSamplers.values().forEach(EnvironmentAttributeSystem.ValueSampler::invalidateTickCache);
     }
 
