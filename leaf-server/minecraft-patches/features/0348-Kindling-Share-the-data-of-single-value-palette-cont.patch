--- a/net/minecraft/world/level/chunk/Strategy.java
+++ b/net/minecraft/world/level/chunk/Strategy.java
@@ -21,6 +21,7 @@ public abstract class Strategy<T> {
     protected final int globalPaletteBitsInMemory;
     private final int bitsPerAxis;
     private final int entryCount;
+    public final net.kindlingmc.chunk.SingleValueData<T> kindling$singleValueData = new net.kindlingmc.chunk.SingleValueData<>(); // Kindling - Share the data of single-value palette containers
 
     private Strategy(final IdMap<T> globalMap, final int bitsPerAxis) {
         this.globalMap = globalMap;
