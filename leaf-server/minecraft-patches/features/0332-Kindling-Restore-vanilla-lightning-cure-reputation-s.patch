@@ -334,10 +334,9 @@ public class ZombieVillager extends Zombie implements VillagerDataHolder {
                 villager.refreshBrain(level);
                 if (this.conversionStarter != null) {
                     Player player = level.getGlobalPlayerByUUID(this.conversionStarter); // Paper - check global player list where appropriate
-                    villager.onReputationEventFromUUID(ReputationEventType.ZOMBIE_VILLAGER_CURED, this.conversionStarter); // Leaf - Use UUID for cure reputation
                     if (player instanceof ServerPlayer serverPlayer) {
                         CriteriaTriggers.CURED_ZOMBIE_VILLAGER.trigger(serverPlayer, this, villager);
-                        //level.onReputationEvent(ReputationEventType.ZOMBIE_VILLAGER_CURED, player, villager); // Leaf - Use UUID for cure reputation - move up
+                        level.onReputationEvent(ReputationEventType.ZOMBIE_VILLAGER_CURED, player, villager); // Kindling - vanilla: only an online player earns the cure discount (undoes Leaf's UUID variant)
                     }
                 }
 
diff --git a/net/minecraft/world/level/NaturalSpawner.java b/net/minecraft/world/level/NaturalSpawner.java
index d799eaa15d4d0278154069ce800d4d560c493331..9accd4dc6e0fc8b5190a8e4558cd4d09b0041b2e 100644
--- a/net/minecraft/world/level/NaturalSpawner.java
+++ b/net/minecraft/world/level/NaturalSpawner.java
@@ -277,11 +277,13 @@ public final class NaturalSpawner {
                 // Paper PR start - throttle failed spawn attempts
                 int spawnCount = spawnCategoryForChunk(mobCategory, level, chunk, state::canSpawn, state::afterSpawn,
                     maxSpawns, level.paperConfig().entities.spawning.perPlayerMobSpawns ? level.getChunkSource().chunkMap::updatePlayerMobTypeMap : null, generator); // Leaf - optimize mob spawning
-                if (spawnCount == 0) {
-                    chunk.failedSpawnAttempts[mobCategory.ordinal()]++;
-                } else {
+                // Kindling start - count failed attempts only while a spawn throttle reads them
+                if (spawnCount != 0) {
                     chunk.failedSpawnAttempts[mobCategory.ordinal()] = 0;
+                } else if (net.kindlingmc.spawn.FailedSpawnThrottle.isEnabled(level)) {
+                    chunk.failedSpawnAttempts[mobCategory.ordinal()]++;
                 }
+                // Kindling end - count failed attempts only while a spawn throttle reads them
                 // Paper end PR - throttle failed spawn attempts
                 // Paper end - Optional per player mob spawns
             }
diff --git a/net/minecraft/world/level/chunk/LevelChunk.java b/net/minecraft/world/level/chunk/LevelChunk.java
index 9851a60140f9989fbac317db200d8484d43ee16c..1c6781787648fca9b02c218870d9a530952e9e6f 100644
