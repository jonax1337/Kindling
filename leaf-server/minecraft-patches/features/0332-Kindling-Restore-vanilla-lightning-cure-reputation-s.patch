+++ b/net/minecraft/world/entity/ai/behavior/InsideBrownianWalk.java
@@ -28,8 +28,9 @@ public class InsideBrownianWalk {
                         );
 
                         // Fisher-Yates shuffle is faster for this case
+                        java.util.concurrent.ThreadLocalRandom shuffleRandom = java.util.concurrent.ThreadLocalRandom.current(); // Kindling - vanilla's Collections.shuffle never drew from the mob's own random
                         for (int index = poses.length - 1; index > 0; index--) {
-                            int j = body.getRandom().nextInt(index + 1);
+                            int j = shuffleRandom.nextInt(index + 1); // Kindling - vanilla's Collections.shuffle never drew from the mob's own random
