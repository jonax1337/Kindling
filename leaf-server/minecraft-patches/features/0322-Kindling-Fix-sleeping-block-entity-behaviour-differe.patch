+    /** As Paper's push: a hopper that found items but moved none into a container that is not full waits a transfer cooldown. */
+    private static void cooldownAfterFailedPush(final Level level, final HopperBlockEntity hopper, final boolean destinationFull) {
+        if (level.paperConfig().hopper.cooldownWhenFull && !destinationFull) {
+            hopper.setCooldown(level.spigotConfig.hopperTransfer);
+        }
+    }
+
+    /** As Paper's pull: a hopper that could take an item that then did not fit waits a transfer cooldown. */
+    private static void cooldownAfterFailedPull(final Level level, final HopperBlockEntity hopper, final boolean failedOnTakeableItem) {
+        if (failedOnTakeableItem && level.paperConfig().hopper.cooldownWhenFull) {
+            applyCooldown(hopper);
+        }
+    }
+
+    /**
+     * A plugin's search result counts as the found inventory when it is the same double chest in another wrapper:
+     * Lithium caches a double chest as its own {@code CompoundContainer}, a plugin hands back Bukkit's.
+     */
+    private static boolean isSameInventory(final @Nullable Container searched, final @Nullable Container found) {
+        return searched == found
+            || searched instanceof net.minecraft.world.CompoundContainer searchedChest
+            && found instanceof net.minecraft.world.CompoundContainer foundChest
+            && searchedChest.container1 == foundChest.container1
+            && searchedChest.container2 == foundChest.container2;
+    }
+    // Kindling end - Fix sleeping block entity behaviour differences
 
