+    // Kindling start - Fix sleeping block entity behaviour differences
+    /**
+     * Purpur's furnace looks for lava below every 20 ticks while it has something to smelt and no fuel; nothing would
+     * wake a sleeping furnace when lava flows in.
+     */
+    private boolean waitsForLavaFromUnderneath() {
+        return this.level.purpurConfig.furnaceUseLavaFromUnderneath && this.items.get(1).isEmpty() && !this.items.get(0).isEmpty();
+    }
+    // Kindling end - Fix sleeping block entity behaviour differences
