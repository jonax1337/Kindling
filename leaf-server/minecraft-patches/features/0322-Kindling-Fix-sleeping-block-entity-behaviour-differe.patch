+            return;
+        }
+        // Kindling start - Fix sleeping block entity behaviour differences: skip one check after a plugin's cooldown, as the name says, then sleep again
+        if (this.skipNextSleepCheckAfterCooldown) {
+            this.skipNextSleepCheckAfterCooldown = false;
             return;
         }
+        if (!net.kindlingmc.sleeping.SleepingHopperRules.mayFallAsleep(this.level.spigotConfig.hopperCheck)) {
+            return;
+        }
+        // Kindling end - Fix sleeping block entity behaviour differences
         if (isSleeping()) {
             return;
         }
