From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jonax1337 <jonas.laux@hotmail.com>
Date: Mon, 26 Oct 2026 21:03:45 +0100
Subject: [PATCH] Kindling: Compute only the 5-second TPS for the lagging check


diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index 1762520cf455b304a3f34aec73d46bdf1dd3ca67..89ddfc7a547c4624b9ddc2dcc32dc7d943af36d3 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -441,6 +441,15 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         }
     }
 
+    // Kindling start - the lagging check runs every tick and needs only the 5-second average; the tick before cleared
+    // the cached averages, so asking for all of them walked the 1, 5 and 15 minute windows (about 25 000 ticks) each tick
+    private double getTPS5s() {
+        synchronized (this.statsLock) {
+            return getTPS(this.tickTimes5s, this.tickRateManager().nanosecondsPerTick());
+        }
+    }
+    // Kindling end - the lagging check needs only the 5-second average
+
     public double[] getTPSIncluding5SecondsReadOnly() {
         synchronized (this.statsLock) {
             double[] tps5s = this.tps5s;
@@ -1393,7 +1402,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
                         io.papermc.paper.configuration.GlobalConfiguration.get().misc.catchupTicks.or(5)
                     );
 
-                    lagging = getTPSIncluding5SecondsReadOnly()[0] < org.purpurmc.purpur.PurpurConfig.laggingThreshold; // Purpur - Lagging threshold // Gale - Purpur - 5-second TPS average
+                    lagging = this.getTPS5s() < org.purpurmc.purpur.PurpurConfig.laggingThreshold; // Purpur - Lagging threshold // Gale - Purpur - 5-second TPS average // Kindling - only the 5-second average
 
                     // adjust ticksBehind so that it is not greater-than catchup
                     if (ticksBehind - catchup > 0L) {
