+
+    // keeps what the header stored for the chunk, which is not what the header says once it has been recalculated
+    private void keepUnreadableSectors(final ChunkPos pos, final int storedOffset, final String problem) {
+        if (!ca.spottedleaf.moonrise.patches.chunk_system.storage.RegionFileRecovery.isChunkStorage(this.info)) {
+            return;
+        }
+
+        try {
+            final IOException cause = new IOException("Chunk " + pos + " in " + this.path.toAbsolutePath() + " " + problem);
+            net.kindlingmc.chunk.ChunkQuarantine.forRegionFolder(this.info.level(), this.info.dimension().identifier().toString(), this.path.getParent())
+                .keep(pos.x(), pos.z(), maxBytes -> this.readStoredSectors(pos, storedOffset, maxBytes), cause);
+        } catch (final RuntimeException ex) { // the caller reports the chunk as unreadable either way
+            LOGGER.warn("No copy of the unreadable chunk {} in {} could be kept: {}", pos, this.path.toAbsolutePath(), ex.toString());
+        }
+    }
+
+    // every byte of the sectors that the header allotted to the chunk and the file still holds, none when it holds none
+    private byte[] readStoredSectors(final ChunkPos pos, final int storedOffset, final long maxBytes) throws IOException {
+        final long sector = getSectorNumber(storedOffset);
+        final long start = sector * 4096L;
+        long sectors = getNumSectors(storedOffset);
+        if (sectors == MAX_INTERNAL_SECTORS) {
+            sectors = roundToSectors(this.readLength(sector) + 4L);
+        }
+
+        final long size = Math.min(sectors * 4096L, this.file.size() - start);
+        if (size <= 0) {
+            return new byte[0];
+        }
+        if (size > maxBytes) {
+            throw new net.kindlingmc.chunk.ChunkQuarantine.OverCapException("Chunk " + pos + " in " + this.path.toAbsolutePath() + " is larger than the " + maxBytes + " bytes allowed");
+        }
+
+        final ByteBuffer stored = ByteBuffer.allocate((int) size);
+        if (size != this.readFully(stored, start)) {
+            throw new IOException("Unexpected end of file reading chunk " + pos + " in " + this.path.toAbsolutePath());
+        }
+        return this.withExternalFile(pos, stored.array(), maxBytes);
+    }
     // Kindling end - raw chunk bytes for the unreadable chunk quarantine
 
