diff --git a/net/minecraft/world/level/biome/BiomeManager.java b/net/minecraft/world/level/biome/BiomeManager.java
index 95fa5539748af619762a70746894edac6753eaba..080fe5fb18c075b6d81a088bf8fdbc9d54c7d573 100644
--- a/net/minecraft/world/level/biome/BiomeManager.java
+++ b/net/minecraft/world/level/biome/BiomeManager.java
@@ -79,6 +79,16 @@ public class BiomeManager {
         int x = xMinus2 >> 2; // BlockPos to BiomePos
         int y = yMinus2 >> 2;
         int z = zMinus2 >> 2;
+        // Kindling start - biome zoom shortcut
+        BiomeResolver cells = this.noiseBiomeSource;
+        if (org.dreeam.leaf.config.modules.opt.BiomeZoomShortcut.enabled && net.kindlingmc.biome.UniformBiomeCells.shareChunkColumn(x, z)) {
+            cells = chunk != null && chunk.locX == x >> 2 && chunk.locZ == z >> 2 ? chunk : this.noiseBiomeSource.chunkResolver(x, z);
+            Holder<Biome> uniform = cells.getUniformNoiseBiome(x, y, z);
+            if (uniform != null) {
+                return uniform;
+            }
+        }
+        // Kindling end - biome zoom shortcut
         // Leaf start - Optimized getBiome method - eliminate divisions
         // any integer & 3 falls in [0,1,2,3]
         // then the division by 4 result is deterministic [0, 0.25, 0.5, 0.75]
@@ -102,7 +112,7 @@ public class BiomeManager {
                 minQuartYY = Mth.square(Math.max(Math.abs(quartYY) - MAX_OFFSET, 0.0));
                 minQuartZZ = Mth.square(Math.max(Math.abs(quartZZ) - MAX_OFFSET, 0.0));
                 double minQuartXX = Mth.square(Math.max(Math.abs(quartXX) - MAX_OFFSET, 0.0));
-                if (smallestDist < minQuartXX + minQuartYY + minQuartZZ) continue;
+                if (smallestDist < minQuartZZ + minQuartYY + minQuartXX) continue; // Kindling - add up in vanilla's order, z + y + x, so a candidate vanilla picks is never skipped
             }
             int xx = everyOtherQuad ? x : x + 1;
             int yy = everyOtherPair ? y : y + 1;
@@ -117,14 +127,14 @@ public class BiomeManager {
             seed = LinearCongruentialGenerator.next(seed, zz);
             double offsetX = getFiddle(seed);
             double sqrX = Mth.square(quartXX + offsetX);
-            if (biomeX != 0 && smallestDist < sqrX + minQuartYY + minQuartZZ) continue; //skip the rest of the loop
+            if (biomeX != 0 && smallestDist < minQuartZZ + minQuartYY + sqrX) continue; //skip the rest of the loop // Kindling - add up in vanilla's order
             seed = LinearCongruentialGenerator.next(seed, this.biomeZoomSeed);
             double offsetY = getFiddle(seed);
             double sqrY = Mth.square(quartYY + offsetY);
-            if (biomeX != 0 && smallestDist < sqrX + sqrY + minQuartZZ) continue; // skip the rest of the loop
+            if (biomeX != 0 && smallestDist < minQuartZZ + sqrY + sqrX) continue; // skip the rest of the loop // Kindling - add up in vanilla's order
             seed = LinearCongruentialGenerator.next(seed, this.biomeZoomSeed);
             double offsetZ = getFiddle(seed);
-            double biomeDist = sqrX + sqrY + Mth.square(quartZZ + offsetZ);
+            double biomeDist = Mth.square(quartZZ + offsetZ) + sqrY + sqrX; // Kindling - add up in vanilla's order, so ties and roundings fall the same way
 
             if (smallestDist > biomeDist) {
                 smallestX = biomeX;
@@ -137,7 +147,7 @@ public class BiomeManager {
         if (chunk != null && chunk.locX == x1 >> 2 && chunk.locZ == z1 >> 2) {
             return chunk.getNoiseBiome(x1, y1, z1);
         }
-        return this.noiseBiomeSource.getNoiseBiome(x1, y1, z1);
+        return cells.getNoiseBiome(x1, y1, z1); // Kindling - biome zoom shortcut: read from the chunk it already looked up
         // Leaf end - Carpet-Fixes - Optimized getBiome method
     }
     // Leaf end - cache getBiome
diff --git a/net/minecraft/world/level/biome/BiomeResolver.java b/net/minecraft/world/level/biome/BiomeResolver.java
