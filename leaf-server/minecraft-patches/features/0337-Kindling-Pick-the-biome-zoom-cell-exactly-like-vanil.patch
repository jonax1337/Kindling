@@ -9,6 +9,24 @@ import net.minecraft.core.QuartPos;
 public interface BiomeResolver {
     Holder<Biome> getNoiseBiome(final int quartX, final int quartY, final int quartZ);
 
+    // Kindling start - biome zoom shortcut
+    /**
+     * The resolver that answers for the cells of the chunk holding quart column (quartX, quartZ), found with at most one
+     * chunk lookup: that chunk, or this resolver when it has none to offer.
+     */
+    default BiomeResolver chunkResolver(final int quartX, final int quartZ) {
+        return this;
+    }
+
+    /**
+     * The biome of all eight cells from (quartX, quartY, quartZ) to (quartX + 1, quartY + 1, quartZ + 1) when this
+     * resolver can tell without reading them one by one, else null.
+     */
+    default @org.jspecify.annotations.Nullable Holder<Biome> getUniformNoiseBiome(final int quartX, final int quartY, final int quartZ) {
+        return null;
+    }
+    // Kindling end - biome zoom shortcut
+
     default Set<Holder<Biome>> getBiomesWithin(final int x, final int y, final int z, final int radius) {
         int x0 = QuartPos.fromBlock(x - radius);
         int y0 = QuartPos.fromBlock(y - radius);
