         return this.uncachedBiomeResolver.getNoiseBiome(quartX, quartY, quartZ);
     }
 
+    // Kindling start - biome zoom shortcut
+    @Override
+    public net.minecraft.world.level.biome.BiomeResolver chunkResolver(final int quartX, final int quartZ) {
+        final ChunkAccess chunk = this.getChunk(quartX >> 2, quartZ >> 2, ChunkStatus.BIOMES, false);
+        return chunk != null ? chunk : this;
+    }
+    // Kindling end - biome zoom shortcut
+
     @Override
     public LevelLightEngine getLightEngine() {
         return this.level.getLightEngine();
