From: jonax1337 <jonas.laux@hotmail.com>
Date: Wed, 28 Oct 2026 21:52:33 +0100
Subject: [PATCH] Kindling: Keep hoppers asleep through Paper's temporary move
 counts and wake furnaces and brewing stands on in-place stack changes


diff --git a/net/minecraft/world/item/ItemStack.java b/net/minecraft/world/item/ItemStack.java
index f9a0e3fee0b234c9ef9fdcba35a0b64389d01e4b..21ef0d24fb4cae074e498aa4b6bc585597728cc6 100644
--- a/net/minecraft/world/item/ItemStack.java
+++ b/net/minecraft/world/item/ItemStack.java
@@ -1404,6 +1404,21 @@ public final class ItemStack implements DataComponentHolder, ItemInstance, net.c
         this.count = count;
     }
 
+    // Kindling start - Paper's hopper changes a count for its move event and sets it back
+    /**
+     * Sets a count that the caller sets back with {@link #setCount(int)}, or replaces this stack in its inventory after,
+     * before it returns. Hoppers sleeping on the inventory are not woken by the count that is set back.
+     */
+    public void setCountTemporarily(final int count) {
+        if (count > 0 && count != this.count && this.subscriber instanceof net.caffeinemc.mods.lithium.common.util.change_tracking.ChangeSubscriber.CountChangeSubscriber<ItemStack> countChangeSubscriber) {
+            countChangeSubscriber.kindling$notifyTemporaryCount(this, this.subscriberData, count);
+            this.count = count;
+        } else {
+            this.setCount(count);
+        }
+    }
+    // Kindling end - Paper's hopper changes a count for its move event and sets it back
+
     public void limitSize(final int maxStackSize) {
         if (!this.isEmpty() && this.getCount() > maxStackSize) {
             this.setCount(maxStackSize);
