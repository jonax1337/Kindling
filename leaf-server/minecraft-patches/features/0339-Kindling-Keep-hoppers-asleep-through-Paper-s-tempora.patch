     protected static final int SLOT_INPUT = 0;
     protected static final int SLOT_FUEL = 1;
     protected static final int SLOT_RESULT = 2;
@@ -593,7 +593,7 @@ public abstract class AbstractFurnaceBlockEntity extends BaseContainerBlockEntit
     private void checkSleep(final BlockState state) {
         if (!this.isLit() && this.cookingTimer == 0 && (state.is(net.minecraft.world.level.block.Blocks.FURNACE) || state.is(net.minecraft.world.level.block.Blocks.BLAST_FURNACE) || state.is(net.minecraft.world.level.block.Blocks.SMOKER)) && this.level != null
             && !this.waitsForLavaFromUnderneath()) { // Kindling - Fix sleeping block entity behaviour differences
-            this.lithium$startSleeping();
+            this.sleepUntilContentChanges(); // Kindling - Wake sleeping block entities on in-place stack changes
         }
     }
 
