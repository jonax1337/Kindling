From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jonax1337 <jonas.laux@hotmail.com>
Date: Wed, 28 Oct 2026 00:53:08 +0100
Subject: [PATCH] Kindling: Optional client-paced chunk sending


diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java b/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
index 116a66303a1da9a9b5bfc3560d7adb4778c96cbb..7a0a3fe7e38322d002a0f16aa2faf0e6275bd371 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
@@ -845,7 +845,10 @@ public final class RegionizedPlayerChunkLoader {
             }
 
             // try to pull sending chunks
-            final long maxSends = Math.max(0L, Math.min(MAX_RATE, Math.min(this.sendQueue.size(), Integer.MAX_VALUE))); // note: no logic to track concurrent sends
+            // Kindling start - optional client-paced chunk sending
+            final net.kindlingmc.chunk.ClientPacedChunkSender pacedSender = this.player.connection.pacedChunkSender;
+            final long maxSends = Math.max(0L, Math.min(MAX_RATE, Math.min(this.sendQueue.size(), pacedSender.takeAllowance(net.minecraft.server.MinecraftServer.currentTick)))); // note: no logic to track concurrent sends
+            // Kindling end - optional client-paced chunk sending
             final long maxSendsThisTick = this.chunkSendLimiter.takeAllocation(maxSends);
             // we do not return sends that we took from the allocation back because we want to limit the max send rate, not target it
             for (long i = 0; i < maxSendsThisTick; ++i) {
@@ -863,18 +866,22 @@ public final class RegionizedPlayerChunkLoader {
                     chunk.postProcessGeneration(this.world);
                     // check if there was any recursive action
                     if (this.removed || this.sendQueue.isEmpty() || this.sendQueue.firstLong() != pendingSend) {
+                        pacedSender.finishBatch(); // Kindling - optional client-paced chunk sending
                         return;
                     } // else: good to dequeue and send, fall through
                 }
                 this.sendQueue.dequeueLong();
 
+                pacedSender.beforeChunk(); // Kindling - optional client-paced chunk sending
                 this.sendChunk(pendingSendX, pendingSendZ);
 
                 if (this.removed) {
                     // sendChunk may invoke plugin logic
+                    pacedSender.finishBatch(); // Kindling - optional client-paced chunk sending
                     return;
                 }
             }
+            pacedSender.finishBatch(); // Kindling - optional client-paced chunk sending
 
             this.flushDelayedTicketOps();
         }
diff --git a/net/minecraft/server/network/ServerGamePacketListenerImpl.java b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
index dedcc939275146c294ceace37df472bbce05df08..23fb2e17634c2a8c00093bc309c77191775d5a54 100644
--- a/net/minecraft/server/network/ServerGamePacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
@@ -273,6 +273,7 @@ public class ServerGamePacketListenerImpl
     private static final Component INVALID_COMMAND_SIGNATURE = Component.translatable("chat.disabled.invalid_command_signature").withStyle(ChatFormatting.RED);
     public ServerPlayer player;
     public final PlayerChunkSender chunkSender;
+    public final net.kindlingmc.chunk.ClientPacedChunkSender pacedChunkSender = new net.kindlingmc.chunk.ClientPacedChunkSender(this); // Kindling - optional client-paced chunk sending
     private int tickCount;
     private int ackBlockChangesUpTo = -1;
     private final TickThrottler dropSpamThrottler = new TickThrottler(20, 1480);
@@ -3896,6 +3897,7 @@ public class ServerGamePacketListenerImpl
     public void handleChunkBatchReceived(final ServerboundChunkBatchReceivedPacket packet) {
         PacketUtils.ensureRunningOnSameThread(packet, this, this.player.level());
         this.chunkSender.onChunkBatchReceivedByClient(packet.desiredChunksPerTick());
+        this.pacedChunkSender.onBatchAnswered(packet.desiredChunksPerTick()); // Kindling - optional client-paced chunk sending
     }
 
     @Override
