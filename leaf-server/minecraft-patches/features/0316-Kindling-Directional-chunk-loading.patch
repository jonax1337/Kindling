         private final LongHeapPriorityQueue sendQueue = new LongHeapPriorityQueue(this.queueComparator);
         private final LongHeapPriorityQueue tickingQueue = new LongHeapPriorityQueue(this.queueComparator);
@@ -927,6 +939,46 @@ public final class RegionizedPlayerChunkLoader {
             );
         }
 
+        // Kindling start - load chunks ahead of fast players first
+        /**
+         * The queue order of a chunk at the given offset: its squared distance, shrunk ahead of a moving player and grown
+         * behind it (times {@code 1 - w cos θ}, θ the angle to the direction of travel, w its weight). Along any one direction
+         * the order stays by distance, so the chunks right in front never wait for farther ones.
+         */
+        private double priority(final int diffX, final int diffZ) {
+            final double squared = (double) diffX * diffX + (double) diffZ * diffZ;
+            if (this.lookAheadX == 0.0 && this.lookAheadZ == 0.0) {
+                return squared;
+            }
+            return squared - Math.sqrt(squared) * (diffX * this.lookAheadX + diffZ * this.lookAheadZ);
+        }
+
+        /**
+         * Points the order in the direction between the player's last two chunk crossings, weighted by the share of the
+         * load distance it covers in {@code look-ahead-ticks} at that pace, at most {@link #MAX_DIRECTION_WEIGHT}.
+         * Only the order changes: the same chunks load, those in the direction of travel first.
+         */
+        private void updateLookAhead(final int chunkX, final int chunkZ, final int loadViewDistance) {
+            final long now = net.minecraft.server.MinecraftServer.currentTick;
+            final long elapsed = now - this.lookAheadFromTick;
+            this.lookAheadX = 0.0;
+            this.lookAheadZ = 0.0;
+            final int movedX = chunkX - this.lookAheadFromX;
+            final int movedZ = chunkZ - this.lookAheadFromZ;
+            if (org.dreeam.leaf.config.modules.opt.DirectionalChunkLoading.enabled && this.lookAheadFromX != Integer.MIN_VALUE
+                && elapsed > 0L && elapsed <= LOOK_AHEAD_STALE_TICKS && (movedX != 0 || movedZ != 0)) {
+                final double moved = Math.sqrt((double) movedX * movedX + (double) movedZ * movedZ);
+                final double ahead = moved * org.dreeam.leaf.config.modules.opt.DirectionalChunkLoading.lookAheadTicks / elapsed;
+                final double weight = Math.min(MAX_DIRECTION_WEIGHT, ahead / Math.max(1, loadViewDistance));
+                this.lookAheadX = movedX / moved * weight;
+                this.lookAheadZ = movedZ / moved * weight;
+            }
+            this.lookAheadFromX = chunkX;
+            this.lookAheadFromZ = chunkZ;
+            this.lookAheadFromTick = now;
+        }
+        // Kindling end - load chunks ahead of fast players first
+
         void update() {
             TickThread.ensureTickThread(this.player, "Cannot update player asynchronously");
             if (this.removed) {
@@ -994,6 +1046,7 @@ public final class RegionizedPlayerChunkLoader {
             this.loadingQueue.clear();
             this.loadQueue.clear();
 
+            this.updateLookAhead(currentChunkX, currentChunkZ, loadViewDistance); // Kindling - load chunks ahead of fast players first; the queues are empty here, so the order may change
             this.lastChunkX = currentChunkX;
             this.lastChunkZ = currentChunkZ;
             this.lastSendDistance = sendViewDistance;
